# Job Hunter -- environment configuration
#
# Copy this file to .env. Nothing here is a secret -- there's no external API
# this pipeline calls with credentials -- but the installer/wiring script
# still sets PROJECT_ROOT here, same convention as this project's sibling,
# gumroad-pdf-factory.

# ————————— PROJECT PATH —————————
# Where this project lives on your machine. All skills, scripts, and cron
# jobs read this to locate the project.
#   Windows: PROJECT_ROOT=C:\Users\yourname\Job Finder
PROJECT_ROOT=

# ————————— LIVE MODE —————————
# Set to "on" to enable the autonomous (cron) job-finder / resume-editor runs.
# Leave off until you've tested a manual run from chat.
live_mode=off
