# Job Hunter environment configuration
#
# install.bat / install.command create .env for you and set PROJECT_ROOT.
# Nothing here is a secret: this pipeline calls no credentialed API.

# Where this project lives on your machine. Every skill and cron job reads this
# to find the project.
#   Windows: PROJECT_ROOT=C:\Users\yourname\Job Finder
#   macOS:   PROJECT_ROOT=/Users/yourname/Job Finder
PROJECT_ROOT=
